{
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node10",
        "types": [
            "node"
        ],
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/**/*.d.ts",
        "tests/**/*.ts",
        "script/**/*.ts"
    ]
}
