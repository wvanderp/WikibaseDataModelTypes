{
	"name": "@wvanderp/wikibase-datamodel-types",
	"version": "0.2.0",
	"description": "TypeScript definitions for the Wikibase data model expressed as flat JS objects",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"test": "pnpm lint && tsc",
		"lint": "eslint index.d.ts tests/**/*",
		"fix": "pnpm lint -- --fix",
		"build": "tsc --emitDeclarationOnly --declaration --outDir dist-tmp && rollup -c && rimraf dist-tmp",
		"generate": "ts-node ./gather.ts",
		"prepublishOnly": "pnpm test && pnpm build"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wvanderp/WikibaseDataModelTypes.git"
	},
	"author": "wvanderp",
	"license": "BSD-3-Clause",
	"bugs": {
		"url": "https://github.com/wvanderp/WikibaseDataModelTypes/issues"
	},
	"homepage": "https://github.com/wvanderp/WikibaseDataModelTypes#readme",
	"devDependencies": {
		"@types/node": "22.10.1",
		"@wmde/eslint-config-wikimedia-typescript": "^0.2.12",
		"ts-node": "10.9.2",
		"axios": "^1.16.0",
		"typescript": "^5.7.2",
		"@typescript-eslint/eslint-plugin": "^7.8.0",
		"@typescript-eslint/parser": "^7.8.0",
		"eslint": "^8.57.1",
		"eslint-config-wikimedia": "^0.32.3",
		"rollup": "^4.28.1",
		"rollup-plugin-dts": "^6.1.1",
		"rimraf": "^6.0.1"
	},
	"keywords": [
		"wikibase",
		"wikidata",
		"typescript"
	]
}
